<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.jaime.bamoe.events</groupId>
	<artifactId>bamoe-nocode-reproducer</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>bamoe-nocode-reproducer</name>
	<description>bamoe-nocode-reproducer BAMOE reproducer</description>


	<properties>
		<revision>9.5.0-SNAPSHOT</revision>

		<!-- Java and Compiler Versions -->
		<java.version>21</java.version>
		<maven.compiler.release>${java.version}</maven.compiler.release>
		<maven.compiler-plugin.version>3.14.0</maven.compiler-plugin.version>
		<maven.resources-plugin.version>3.3.1</maven.resources-plugin.version>
		<maven.install-plugin.version>3.1.4</maven.install-plugin.version>
		<maven.deploy-plugin.version>3.1.4</maven.deploy-plugin.version>
		<maven.archetype-plugin.version>3.4.0</maven.archetype-plugin.version>
		<maven.archetype-packaging-extension.version>3.4.0</maven.archetype-packaging-extension.version>
		<maven.surefire-plugin.version>3.5.3</maven.surefire-plugin.version>
		<jacoco.maven-plugin.version>0.8.13</jacoco.maven-plugin.version>

		<!-- Quarkus Platform Properties -->
		<quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
		<quarkus.platform.group-id>io.quarkus</quarkus.platform.group-id>
		<quarkus.platform.version>3.27.5</quarkus.platform.version>

		<!-- BAMOE BOM Properties -->
		<bamoe.bom.group-id>com.ibm.bamoe</bamoe.bom.group-id>
		<bamoe.bom.artifact-id>bamoe-quarkus-bom</bamoe.bom.artifact-id>
		<bamoe.version>9.5.0-ibm-0005</bamoe.version>
		<bamoe.techpreview.bom.artifact-id>bamoe-techpreview-bom</bamoe.techpreview.bom.artifact-id>

		<!-- Mapstruct version -->
		<org.mapstruct.version>1.6.3</org.mapstruct.version>

		<!-- Devmode dependencies dependencies -->
		<quarkus.wiremock.version>1.5.3</quarkus.wiremock.version>
		<quarkus.embedded.postgresql.version>0.8.0</quarkus.embedded.postgresql.version>
		<postgresql.version>17.6.0</postgresql.version>
		<postgresql-jdbc.version>42.7.12</postgresql-jdbc.version>

		<!-- OIDC proxy version -->
		<quarkiverse.oidc.proxy.version>0.3.2</quarkiverse.oidc.proxy.version>

		<!-- Logging Manager version -->
		<quarkiverse.logging-manager.version>3.4.1</quarkiverse.logging-manager.version>

		<!-- MCP Server version -->
		<quarkiverse.mcp-server.version>1.9.1</quarkiverse.mcp-server.version>

		<!-- Apache Commons Lang version -->
		<apache.commons.lang.version>3.18.0</apache.commons.lang.version>

		<!-- Apache Commons Validator library version -->
		<apache.commons.validator.version>1.10.0</apache.commons.validator.version>

		<!-- Google Guava library version -->
		<com.google.guava.version>33.4.8-jre</com.google.guava.version>

		<!-- Lombok library version -->
		<org.projectlombok.version>1.18.40</org.projectlombok.version>

		<!-- Lombok library version -->
		<org.projectlombok.mapstruct.binding.version>0.2.0</org.projectlombok.mapstruct.binding.version>

		<!-- SLF4J library version -->
		<org.slf4j.version>2.0.17</org.slf4j.version>

		<!-- Encoding -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Import Quarkus BOM -->
			<dependency>
				<groupId>${quarkus.platform.group-id}</groupId>
				<artifactId>${quarkus.platform.artifact-id}</artifactId>
				<version>${quarkus.platform.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Import BAMOE BOM -->
			<dependency>
				<groupId>${bamoe.bom.group-id}</groupId>
				<artifactId>${bamoe.bom.artifact-id}</artifactId>
				<version>${bamoe.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Import Additional BAMOE BOM  -->
			<dependency>
				<groupId>${bamoe.bom.group-id}</groupId>
				<artifactId>${bamoe.techpreview.bom.artifact-id}</artifactId>
				<version>${bamoe.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Import PostgreSQL binaries BOM for Embedded PostgreSQL -->
