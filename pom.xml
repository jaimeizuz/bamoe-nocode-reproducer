				<groupId>io.zonky.test.postgres</groupId>
				<artifactId>embedded-postgres-binaries-bom</artifactId>
				<version>${postgresql.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Embedded PostgreSQL library version -->
			<dependency>
				<groupId>io.quarkiverse.embedded.postgresql</groupId>
				<artifactId>quarkus-embedded-postgresql</artifactId>
				<version>${quarkus.embedded.postgresql.version}</version>
			</dependency>

			<!-- Wiremock library version -->
			<dependency>
				<groupId>io.quarkiverse.wiremock</groupId>
				<artifactId>quarkus-wiremock</artifactId>
				<version>${quarkus.wiremock.version}</version>
			</dependency>

			<!-- OIDC Proxy library version -->
			<dependency>
				<groupId>io.quarkiverse.oidc-proxy</groupId>
				<artifactId>quarkus-oidc-proxy</artifactId>
				<version>${quarkiverse.oidc.proxy.version}</version>
			</dependency>

			<!-- Logging Manager library version -->
			<dependency>
				<groupId>io.quarkiverse.loggingmanager</groupId>
				<artifactId>quarkus-logging-manager</artifactId>
				<version>${quarkiverse.logging-manager.version}</version>
			</dependency>

			<!-- Quarkiverse MCP Server -->
			<dependency>
				<groupId>io.quarkiverse.mcp</groupId>
				<artifactId>quarkus-mcp-server-sse</artifactId>
				<version>${quarkiverse.mcp-server.version}</version>
			</dependency>

			<!-- Apache Commons Lang library version -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-lang3</artifactId>
				<version>${apache.commons.lang.version}</version>
			</dependency>

			<!-- Apache Commons Validator library version -->
			<dependency>
				<groupId>commons-validator</groupId>
				<artifactId>commons-validator</artifactId>
				<version>${apache.commons.validator.version}</version>
			</dependency>

			<!-- Mapstruct library version -->
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${org.mapstruct.version}</version>
			</dependency>

			<!-- Guava library version -->
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>${com.google.guava.version}</version>
			</dependency>

			<!-- Lombok library version -->
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${org.projectlombok.version}</version>
			</dependency>

			<!-- Maven Archetype Packaging extension -->
			<dependency>
				<groupId>org.apache.maven.archetype</groupId>
				<artifactId>archetype-packaging</artifactId>
				<version>${maven.archetype-packaging-extension.version}</version>
			</dependency>

			<!-- Sonatype CVE sonatype-2025-003858 -->
			<dependency>
				<groupId>org.postgresql</groupId>
				<artifactId>postgresql</artifactId>
				<version>${postgresql-jdbc.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- SLF4J -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${org.slf4j.version}</version>
		</dependency>
		<!-- jBPM and Drools -->
		<dependency>
			<groupId>org.jbpm</groupId>
			<artifactId>jbpm-with-drools-quarkus</artifactId>
		</dependency>

		<dependency>
			<groupId>org.kie.kogito</groupId>
			<artifactId>process-workitems</artifactId>
		</dependency>

		<!-- BAMOE public API -->
		<dependency>
			<groupId>org.kie.kogito</groupId>
			<artifactId>kogito-api</artifactId>
		</dependency>

		<!-- BAMOE Persistence -->
		<dependency>
			<groupId>org.kie</groupId>
			<artifactId>kie-addons-quarkus-persistence-jdbc</artifactId>
		</dependency>
