    <bpmn2:scriptTask id="_F6911975-A619-4E9C-9B16-CF0E182614DC" name="Build SLA notifications" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Build SLA notifications]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_33B38176-DD12-4649-B6C2-151D12AF3BD8</bpmn2:incoming>
      <bpmn2:outgoing>_AA10907A-9EE9-4CC7-9721-E27DD5204CEB</bpmn2:outgoing>
      <bpmn2:script>NotificationList notificationsTmp = new NotificationList();

notificationsTmp.addNotification(new NotificationInfo("FINAL", null, slaInSeconds));

if(slaFirstWarnPercentage != null &amp;&amp; !slaFirstWarnPercentage.isEmpty())
    notificationsTmp.addNotification(new NotificationInfo("FIRST_WARN", slaFirstWarnPercentage, slaInSeconds));

if(slaSecondWarnPercentage != null &amp;&amp; !slaSecondWarnPercentage.isEmpty())
    notificationsTmp.addNotification(new NotificationInfo("SECOND_WARN", slaSecondWarnPercentage, slaInSeconds));

kcontext.setVariable("notifications", notificationsTmp.getNotifications());</bpmn2:script>
    </bpmn2:scriptTask>
